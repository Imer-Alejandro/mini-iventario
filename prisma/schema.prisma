generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. PRODUCTOS, CATEGORÃAS Y UBICACIONES
// ----------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  categoryId        String?   @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id])
  unit              String // "kg", "lb", "unidad", etc.
  allowsDecimals    Boolean   @default(true) @map("allows_decimals")
  price             Decimal
  cost              Decimal   @default(0)
  minStock          Decimal   @default(0) @map("min_stock")
  targetStock       Decimal   @default(0) @map("target_stock")
  currentStock      Decimal   @default(0) @map("current_stock")
  iconId            String?   @map("icon_id")
  mainSupplierId    String?   @map("main_supplier_id")
  mainSupplier      Supplier? @relation(fields: [mainSupplierId], references: [id])
  autoPurchaseOrder Boolean   @default(false) @map("auto_purchase_order")
  status            String    @default("ACTIVE") // ACTIVE | INACTIVE

  stockByLocations   StockByLocation[]
  movements          InventoryMovement[]
  saleLines          SaleLine[]
  purchaseOrderLines PurchaseOrderLine[]
  alerts             StockAlert[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Location {
  id       String     @id @default(cuid())
  name     String
  parentId String?    @map("parent_id")
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  status   String     @default("ACTIVE")

  stockByLocations StockByLocation[]
  movementsFrom    InventoryMovement[] @relation("MovementsFrom")
  movementsTo      InventoryMovement[] @relation("MovementsTo")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("locations")
}

model StockByLocation {
  productId  String  @map("product_id")
  locationId String  @map("location_id")
  quantity   Decimal @default(0)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([productId, locationId])
  @@map("stock_by_location")
}

// ----------------------------------------------------
// 2. MOVIMIENTOS DE INVENTARIO (LIBRO MAYOR INMUTABLE)
// ----------------------------------------------------

model InventoryMovement {
  id             String    @id @default(cuid())
  productId      String    @map("product_id")
  product        Product   @relation(fields: [productId], references: [id])
  fromLocationId String?   @map("from_location_id")
  fromLocation   Location? @relation("MovementsFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?   @map("to_location_id")
  toLocation     Location? @relation("MovementsTo", fields: [toLocationId], references: [id])
  type           String
  quantity       Decimal
  unitCost       Decimal?  @map("unit_cost")
  referenceType  String?   @map("reference_type") // SALE, RECEIPT, ADJUSTMENT, MERMA
  referenceId    String?   @map("reference_id")
  reason         String?
  clientOpId     String?   @unique @map("client_op_id")
  userId         String    @map("user_id")
  authorizedBy   String?   @map("authorized_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("inventory_movements")
}

// ----------------------------------------------------
// 3. VENTAS Y POS
// ----------------------------------------------------

model Sale {
  id            String       @id @default(cuid())
  number        Int          @unique // Consecutivo atÃ³mico oficial mediante tabla Counters
  customerId    String?      @map("customer_id")
  customer      Customer?    @relation(fields: [customerId], references: [id])
  paymentType   String       @map("payment_type")
  total         Decimal
  status        String       @default("CONFIRMED")
  cashSessionId String?      @map("cash_session_id")
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  clientOpId    String?      @unique @map("client_op_id")
  userId        String       @map("user_id")
  voidReason    String?      @map("void_reason")
  voidedBy      String?      @map("voided_by")
  voidedAt      DateTime?    @map("voided_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  lines SaleLine[]

  @@map("sales")
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String  @map("product_id")
  product     Product @relation(fields: [productId], references: [id])
  productName String  @map("product_name")
  quantity    Decimal
  unitPrice   Decimal @map("unit_price")
  lineTotal   Decimal @map("line_total")

  @@map("sale_lines")
}

// ----------------------------------------------------
// 4. CLIENTES Y CUENTA CORRIENTE (CRÃ‰DITO)
// ----------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  name        String
  documentId  String?  @map("document_id") // CÃ©dula o RNC
  phone       String?
  address     String?
  creditLimit Decimal  @default(0) @map("credit_limit")
  balance     Decimal  @default(0) // Saldo en cachÃ© sincronizado transaccionalmente
  status      String   @default("ACTIVE") // ACTIVE | BLOCKED
  createdAt   DateTime @default(now()) @map("created_at")

  sales  Sale[]
  ledger CustomerLedger[]

  @@map("customers")
}

model CustomerLedger {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String
  amount      Decimal // Positivo incrementa deuda, negativo reduce
  clientOpId  String?  @unique @map("client_op_id")
  referenceId String?  @map("reference_id")
  note        String?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("customer_ledger")
}

// ----------------------------------------------------
// 5. CAJA Y ARQUEO
// ----------------------------------------------------

model CashSession {
  id                    String    @id @default(cuid())
  sessionNumber         Int       @map("session_number")
  userId                String    @map("user_id")
  userName              String    @map("user_name")
  openingAmount         Decimal   @map("opening_amount")
  expectedAmount        Decimal   @default(0) @map("expected_amount")
  countedAmount         Decimal?  @map("counted_amount")
  difference            Decimal?
  diffReason            String?   @map("diff_reason")
  denominationBreakdown String?   @map("denomination_breakdown")
  status                String    @default("OPEN")
  openedAt              DateTime  @default(now()) @map("opened_at")
  closedAt              DateTime? @map("closed_at")

  sales     Sale[]
  movements CashMovement[]

  @@map("cash_sessions")
}

model CashMovement {
  id            String      @id @default(cuid())
  cashSessionId String      @map("cash_session_id")
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  type          String
  amount        Decimal
  clientOpId    String?     @unique @map("client_op_id")
  reason        String?
  userId        String      @map("user_id")
  authorizedBy  String?     @map("authorized_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("cash_movements")
}

// ----------------------------------------------------
// 6. COMPRAS, PROVEEDORES Y CUENTAS POR PAGAR
// ----------------------------------------------------

model Supplier {
  id           String   @id @default(cuid())
  name         String
  rnc          String?
  phone        String?
  address      String?
  contact      String?
  paymentTerms String?  @map("payment_terms")
  balance      Decimal  @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")

  products       Product[]
  purchaseOrders PurchaseOrder[]
  ledger         SupplierLedger[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  orderNumber Int      @unique @map("order_number")
  supplierId  String   @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      String   @default("BORRADOR")
  total       Decimal  @default(0)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal
  receivedQty     Decimal       @default(0) @map("received_qty")
  unitCost        Decimal       @map("unit_cost")
  lineTotal       Decimal       @map("line_total")

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  receiptNumber   Int           @map("receipt_number")
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  locationId      String        @map("location_id")
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("goods_receipts")
}

model SupplierLedger {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  type        String
  amount      Decimal
  clientOpId  String?  @unique @map("client_op_id")
  referenceId String?  @map("reference_id")
  note        String?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("supplier_ledger")
}

// ----------------------------------------------------
// 7. ALERTAS DE STOCK Y REPOSICIÃ“N
// ----------------------------------------------------

model StockAlert {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  currentStock Decimal  @map("current_stock")
  minStock     Decimal  @map("min_stock")
  suggestedQty Decimal  @map("suggested_qty")
  status       String   @default("OPEN")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("stock_alerts")
}

// ----------------------------------------------------
// 8. USUARIOS, ROLES Y PERMISOS (RBAC GRANULAR)
// ----------------------------------------------------

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  pinHash      String        @map("pin_hash")
  passwordHash String?       @map("password_hash")
  roleId       String        @map("role_id")
  role         Role          @relation(fields: [roleId], references: [id])
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now()) @map("created_at")
  sessions     UserSession[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  status      String           @default("ACTIVE")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique // Ej: VENTAS.ANULAR, CREDITO.EXCEDER_LIMITE
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------
// 9. AUDITORÃA INMUTABLE
// ----------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  action       String // CREATE, UPDATE, VOID, APPROVE, LOGIN
  entity       String // SALE, INVENTORY, CASH, CUSTOMER
  entityId     String?  @map("entity_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  clientOpId   String?  @map("client_op_id")
  authorizedBy String?  @map("authorized_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

// ----------------------------------------------------
// 10. CONSECUTIVOS SEGUROS (COUNTERS ATÃ“MICOS)
// ----------------------------------------------------

model Counter {
  series    String @id // Ej: "SALES", "PURCHASE_ORDERS", "RECEIPTS"
  lastValue Int    @default(0) @map("last_value")

  @@map("counters")
}
