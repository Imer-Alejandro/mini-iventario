{
  "name": "mini-inventario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs && node scripts/test-sqlite.mjs",
    "db:migrate": "prisma migrate deploy",
